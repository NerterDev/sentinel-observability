# ==============================================================================
# Sentinel Synthetic Observability — Variáveis de Ambiente e Segredos
# ==============================================================================
# Copie este ficheiro para .env para execução local:
#   cp .env.example .env
#
# No GitHub Actions, configure WAF_BYPASS_TOKEN em:
#   Settings > Secrets and variables > Actions > Repository secrets
# ==============================================================================

# Token secreto para bypass de regras de segurança WAF / Cloudflare Enterprise (ex: Rocket.net)
# Enviado no cabeçalho HTTP: X-WAF-Bypass-Token
WAF_BYPASS_TOKEN=seu_token_secreto_aqui

# Diretórios de configuração e saída (opcionais, com padrões canónicos)
CONFIG_DIR=config
OUTPUT_DIR=dashboard/data
SCREENSHOTS_DIR=public/screenshots

# Modo de depuração e saída detalhada
PYTHONUNBUFFERED=1

